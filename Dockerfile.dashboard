FROM oven/bun:1.4-alpine

WORKDIR /app

# Install dependencies
COPY package.json bun.lockb ./
RUN bun install --production

# Copy dashboard app
COPY apps/dashboard ./apps/dashboard
COPY packages ./packages

# Build dashboard
WORKDIR /app/apps/dashboard
RUN bun run build

# Expose port
EXPOSE 3000

# Start dashboard
CMD ["bun", "run", "start"]
